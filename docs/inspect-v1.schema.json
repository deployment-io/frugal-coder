{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frugal Coder inspect v1",
  "description": "Metadata inspection only. Cross-field arithmetic and ordering are specified in inspection.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture",
    "layout",
    "files",
    "total_tensor_payload_bytes",
    "total_weight_file_bytes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "architectures",
        "text_model_type",
        "recognized",
        "execution_implemented"
      ],
      "properties": {
        "model_type": {
          "type": "string",
          "minLength": 1
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text_model_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "recognized": {
          "type": "boolean"
        },
        "execution_implemented": {
          "const": false
        }
      }
    },
    "layout": {
      "const": "single_safetensors"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file_bytes",
          "header_bytes",
          "payload_bytes",
          "tensors"
        ],
        "properties": {
          "name": {
            "const": "model.safetensors"
          },
          "file_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "header_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "payload_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "tensors": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "shape",
                "dtype",
                "data_offsets",
                "payload_bytes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "shape": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                },
                "dtype": {
                  "enum": [
                    "BOOL",
                    "I8",
                    "U8",
                    "F8_E4M3",
                    "F8_E5M2",
                    "I16",
                    "U16",
                    "F16",
                    "BF16",
                    "I32",
                    "U32",
                    "F32",
                    "I64",
                    "U64",
                    "F64"
                  ]
                },
                "data_offsets": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  }
                },
                "payload_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            }
          }
        }
      }
    },
    "total_tensor_payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "total_weight_file_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
